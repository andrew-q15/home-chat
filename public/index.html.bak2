<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>家庭聊天</title>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, sans-serif; display: flex; height: 100vh; background: #f5f5f5; }

  /* ===== 登录界面 ===== */
  #auth-screen {
    position: fixed; inset: 0; background: #f5f5f5;
    display: flex; align-items: center; justify-content: center;
    z-index: 100;
  }
  #auth-box {
    background: #fff; padding: 28px 24px; border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    width: 300px;
  }
  #auth-box h2 { margin: 0 0 16px; font-size: 18px; text-align: center; color: #333; }
  #auth-box input {
    width: 100%; padding: 10px 12px; margin-bottom: 10px;
    border: 1px solid #ddd; border-radius: 6px; font-size: 15px; outline: none;
  }
  #auth-box input:focus { border-color: #2a6; }
  #auth-box button {
    width: 100%; padding: 10px; border: none; border-radius: 6px;
    background: #2a6; color: #fff; font-size: 15px; cursor: pointer;
    margin-top: 4px;
  }
  #auth-box button:hover { background: #248a52; }
  #auth-switch {
    text-align: center; margin-top: 12px; font-size: 13px; color: #888;
  }
  #auth-switch a { color: #2a6; cursor: pointer; text-decoration: none; }
  #auth-msg { color: #c0392b; font-size: 13px; text-align: center; min-height: 18px; margin-top: 8px; }

  /* ===== 主界面 ===== */
  #chat-screen { display: none; width: 100%; height: 100vh; }
  #chat-screen.active { display: flex; }
  #sidebar { width: 200px; background: #2c2c2c; color: #eee; padding: 12px; font-size: 14px; overflow-y: auto; display: flex; flex-direction: column; }
  #sidebar h3 { margin: 14px 0 8px; font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 1px; }
  #sidebar h3:first-child { margin-top: 0; }
  #channels { flex: 0 0 auto; }
  #channels li, #users li { list-style: none; padding: 6px 8px; border-radius: 6px; cursor: pointer; margin-bottom: 2px; display: flex; align-items: center; justify-content: space-between; }
  #channels li:hover { background: #3a3a3a; }
  #channels li.active { background: #2a6; color: #fff; font-weight: 600; }
  #channels li .del { opacity: 0; color: #f88; font-size: 14px; padding: 0 4px; }
  #channels li:hover .del { opacity: 1; }
  #channels li.active .del { color: #fff; }
  #users li { cursor: default; color: #bbb; font-size: 13px; display: block; }
  #add-channel { margin-top: 8px; padding: 6px 10px; background: transparent; color: #2a6; border: 1px dashed #2a6; border-radius: 6px; cursor: pointer; font-size: 13px; }
  #add-channel:hover { background: #2a6; color: #fff; }
  #me { margin-top: auto; padding-top: 12px; font-size: 12px; color: #888; border-top: 1px solid #444; }
  #me a { color: #f88; cursor: pointer; }
  #main { flex: 1; display: flex; flex-direction: column; }
  #header { padding: 12px 16px; background: #fff; border-bottom: 1px solid #ddd; font-weight: 600; }
  #messages { flex: 1; overflow-y: auto; padding: 16px; }
  .msg { margin-bottom: 10px; }
  .msg .name { font-weight: 600; color: #2a6; margin-right: 6px; }
  .msg .time { font-size: 11px; color: #999; margin-left: 6px; }
  .system { color: #999; font-size: 13px; text-align: center; margin: 8px 0; white-space: pre-wrap; }
  #input-bar { display: flex; padding: 10px; background: #fff; border-top: 1px solid #ddd; }
  #input-bar input { flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 15px; outline: none; }
  #input-bar button { margin-left: 8px; padding: 0 20px; border: none; border-radius: 6px; background: #2a6; color: #fff; font-size: 15px; cursor: pointer; }
</style>
</head>
<body>

<!-- 登录 / 注册 -->
<div id="auth-screen">
  <div id="auth-box">
    <h2 id="auth-title">登录</h2>
    <input id="auth-username" placeholder="用户名" autocomplete="username">
    <input id="auth-password" type="password" placeholder="密码" autocomplete="current-password">
    <button id="auth-submit">登录</button>
    <div id="auth-msg"></div>
    <div id="auth-switch">
      <span id="switch-text">还没有账号？</span>
      <a id="switch-link">注册</a>
    </div>
  </div>
</div>

<!-- 聊天界面 -->
<div id="chat-screen">
  <div id="sidebar">
    <h3>频道</h3>
    <ul id="channels"></ul>
    <button id="add-channel">+ 新建频道</button>
    <h3>在线</h3>
    <ul id="users"></ul>
    <div id="me">我: <span id="me-name"></span> <a id="logout">退出</a></div>
  </div>
  <div id="main">
    <div id="header">—</div>
    <div id="messages"></div>
    <div id="input-bar">
      <input id="input" placeholder="说点什么..." autocomplete="off">
      <button onclick="send()">发送</button>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  // ============ 认证流程 ============
  let token = localStorage.getItem('token');
  let myName = null;
  let socket = null;
  let isRegisterMode = false;

  const authScreen = document.getElementById('auth-screen');
  const chatScreen = document.getElementById('chat-screen');
  const authTitle = document.getElementById('auth-title');
  const authUser = document.getElementById('auth-username');
  const authPass = document.getElementById('auth-password');
  const authSubmit = document.getElementById('auth-submit');
  const authMsg = document.getElementById('auth-msg');
  const switchText = document.getElementById('switch-text');
  const switchLink = document.getElementById('switch-link');

  switchLink.addEventListener('click', () => {
    isRegisterMode = !isRegisterMode;
    authTitle.textContent = isRegisterMode ? '注册' : '登录';
    authSubmit.textContent = isRegisterMode ? '注册' : '登录';
    switchText.textContent = isRegisterMode ? '已有账号？' : '还没有账号？';
    switchLink.textContent = isRegisterMode ? '登录' : '注册';
    authMsg.textContent = '';
  });

  authSubmit.addEventListener('click', submitAuth);
  authPass.addEventListener('keydown', e => { if (e.key === 'Enter') submitAuth(); });
  authUser.addEventListener('keydown', e => { if (e.key === 'Enter') authPass.focus(); });

  async function submitAuth() {
    const username = authUser.value.trim();
    const password = authPass.value;
    authMsg.textContent = '';
    if (!username || !password) {
      authMsg.textContent = '用户名和密码不能为空';
      return;
    }
    const url = isRegisterMode ? '/api/register' : '/api/login';
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password }),
      });
      const data = await res.json();
      if (!data.ok) { authMsg.textContent = data.msg || '失败'; return; }
      token = data.token;
      myName = data.username;
      localStorage.setItem('token', token);
      enterChat();
    } catch (err) {
      authMsg.textContent = '网络错误';
    }
  }

  async function checkAuth() {
    if (!token) return;
    try {
      const res = await fetch('/api/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const data = await res.json();
      if (data.ok) {
        myName = data.username;
        enterChat();
      } else {
        localStorage.removeItem('token');
        token = null;
      }
    } catch {}
  }

  function enterChat() {
    authScreen.style.display = 'none';
    chatScreen.classList.add('active');
    document.getElementById('me-name').textContent = myName;
    startSocket();
  }

  document.getElementById('logout').addEventListener('click', () => {
    localStorage.removeItem('token');
    localStorage.removeItem('channel');
    location.reload();
  });

  // ============ Socket 逻辑 ============
  let currentChannel = localStorage.getItem('channel') || null;
  let allChannels = [];

  const channelsEl = document.getElementById('channels');
  const usersEl = document.getElementById('users');
  const messagesEl = document.getElementById('messages');
  const headerEl = document.getElementById('header');
  const inputEl = document.getElementById('input');

  function startSocket() {
    socket = io({ auth: { token } });

    socket.on('connect_error', (err) => {
      if (err.message === '未登录') {
        localStorage.removeItem('token');
        location.reload();
      }
    });

    socket.on('channels', (list) => {
      allChannels = list;
      if (!currentChannel || !list.includes(currentChannel)) {
        currentChannel = list[0];
        messagesEl.innerHTML = '';
      }
      renderChannels();
      if (currentChannel) doJoin(currentChannel);
    });

    function renderChannels() {
      channelsEl.innerHTML = allChannels.map(c => `
        <li class="${c === currentChannel ? 'active' : ''}" data-ch="${escapeAttr(c)}">
          <span class="ch-name"># ${escapeHtml(c)}</span>
          <span class="del" title="删除频道" data-del="${escapeAttr(c)}">×</span>
        </li>
      `).join('');
      channelsEl.querySelectorAll('li').forEach(li => {
        li.addEventListener('click', (e) => {
          if (e.target.dataset.del) {
            e.stopPropagation();
            const ch = e.target.dataset.del;
            if (confirm(`删除频道 #${ch}？`)) socket.emit('delete_channel', ch);
            return;
          }
          switchChannel(li.dataset.ch);
        });
      });
    }

    window.switchChannel = function(channel) {
      if (channel === currentChannel && headerEl.textContent !== '—') return;
      currentChannel = channel;
      localStorage.setItem('channel', channel);
      headerEl.textContent = '# ' + channel;
      messagesEl.innerHTML = '';
      usersEl.innerHTML = '';
      doJoin(channel);
      renderChannels();
    };

    window.doJoin = function(channel) {
      socket.emit('join', { channel });
    };

    document.getElementById('add-channel').addEventListener('click', () => {
      const name = prompt('新频道名（最多 20 字）：');
      if (!name) return;
      socket.emit('create_channel', name.trim());
    });

    socket.on('system_all', (text) => addMsg(`<div class="system">${escapeHtml(text)}</div>`));
    socket.on('channel_deleted', (name) => {
      if (currentChannel === name) {
        messagesEl.innerHTML = ''; usersEl.innerHTML = '';
        currentChannel = null; headerEl.textContent = '—';
      }
    });
    socket.on('error_msg', (text) => alert(text));
    socket.on('history', (list) => list.forEach(renderMsg));
    socket.on('message', renderMsg);
    socket.on('system', (text) => addMsg(`<div class="system">${escapeHtml(text)}</div>`));
    socket.on('users', (list) => {
      usersEl.innerHTML = list.map(n => `<li>${escapeHtml(n)}</li>`).join('');
    });
  }

  function addMsg(html) {
    const div = document.createElement('div');
    div.innerHTML = html;
    messagesEl.appendChild(div);
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }

  function renderMsg(m) {
    const t = new Date(m.time).toLocaleTimeString('zh-CN', {hour:'2-digit', minute:'2-digit'});
    addMsg(`<div class="msg"><span class="name">${escapeHtml(m.name)}</span>${escapeHtml(m.text)}<span class="time">${t}</span></div>`);
  }

  window.send = function() {
    const text = inputEl.value.trim();
    if (!text || !socket) return;
    socket.emit('message', text);
    inputEl.value = '';
  };

  inputEl.addEventListener('keydown', e => { if (e.key === 'Enter') send(); });

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function escapeAttr(s) {
    return String(s).replace(/"/g, '&quot;');
  }

  // ============ 启动 ============
  checkAuth();
</script>
</body>
</html>